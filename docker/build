# =================================================================================================
# This script builds the Docker container for the ROS 2 Benchmarking Suite.
# It supports multiple ROS 2 distributions and allows specifying the build target.
#
# Usage:
#   ./build_benchmark_container.sh [ROS_DISTRO] [CONTAINER_BUILD_TARGET]
# =================================================================================================

# Supported ROS 2 distributions
usage() {
  echo "Usage: $0 [-d <ros_distro>] [-a <architecture>] [-w <overlay_workspace>] [--skip-keys <keys>]"
  echo "  -w <overlay_workspace>: install a local workspace's dependencies into the image"
  echo "                          so it can be built against the container later (docker/run -w)."
  echo "                          The workspace itself is not copied or built into the image."
  echo "  --skip-keys <keys>:     space-separated rosdep keys to skip when resolving those deps."
  exit 1
}
SUPPORTED_DISTROS=("jazzy" "kilted" "lyrical" "rolling")
# The ROS distribution to build the container for (default is "jazzy")
ROS_DISTRO="jazzy"
ARCH="$(dpkg --print-architecture)"
OVERLAY_WS=""
ROSDEP_SKIP_KEYS=""

while [[ $# -gt 0 ]]; do
  key="$1"
  case $key in
  -d | --distro)
    ROS_DISTRO="$2"
    shift 2
    ;;
  -a | --architecture)
    ARCH="$2"
    shift 2
    ;;
  -w | --workspace)
    OVERLAY_WS="$2"
    shift 2
    ;;
  --skip-keys)
    ROSDEP_SKIP_KEYS="$2"
    shift 2
    ;;
  *)
    echo "Unknown option: $key"
    usage
    ;;
  esac

done

if [[ ! "${SUPPORTED_DISTROS[@]}" =~ "${ROS_DISTRO}" ]]; then
    echo "ERROR: Unsupported ROS 2 distribution: '${ROS_DISTRO}'"
    echo "Supported distributions are: ${SUPPORTED_DISTROS[*]}. Default to 'jazzy'."
    exit 1
fi

# Optionally install a local workspace's dependencies into the image
# (docker/build -w), so that workspace can be built against this container later
# (e.g. mounted via docker/run -w) with its deps already present. Only the deps
# are installed -- the workspace itself is NOT copied or built in. rosdep
# resolves them; use --skip-keys for any that must not be installed. Resolve the
# path here, before we cd into the repo, so a relative -w is against the caller's
# cwd. Left unset, docker-bake.hcl defaults the overlay to an empty placeholder.
if [[ -n "${OVERLAY_WS}" ]]; then
  OVERLAY_SRC="${OVERLAY_WS}"
  [[ -d "${OVERLAY_WS}/src" ]] && OVERLAY_SRC="${OVERLAY_WS}/src"
  OVERLAY_CONTEXT="$(cd "${OVERLAY_SRC}" >/dev/null 2>&1 && pwd)"
  if [[ -z "${OVERLAY_CONTEXT}" ]]; then
    echo "ERROR: overlay workspace '${OVERLAY_WS}' not found."
    exit 1
  fi
  echo "Baking overlay workspace source ${OVERLAY_CONTEXT} into the image."
  export OVERLAY_CONTEXT
fi
export ROSDEP_SKIP_KEYS

# Export the ROS_DISTRO variable for docker-bake.hcl
export DISTRO="${ROS_DISTRO}"

# The build target to use from docker-bake.hcl (default is "default")
CONTAINER_BUILD_TARGET="${ARCH}"

THIS_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null && pwd )"
PARENT_DIR=$(dirname "${THIS_DIR}")
cd "$PARENT_DIR"

# Populate external/ from external.repos before the build copies it into the
# image. --skip-existing imports any manifest entry that isn't checked out yet
# (so adding a new repo Just Works)
if command -v vcs >/dev/null 2>&1; then
  echo "Cloning external dependencies..."
  if ! vcs import --input external.repos --recursive --skip-existing .; then
    echo "ERROR: 'vcs import' failed, so external/ was not fully populated."
    echo "If this is a pkg_resources error, vcstool needs setuptools<82 (vcstool#292)."
    exit 1
  fi
elif [ ! -d external/ros2-performance ]; then
  echo "ERROR: external/ is not populated and vcstool ('vcs') is not installed."
  echo "Install it (e.g. 'pipx install vcstool') or run 'vcs import --input external.repos --recursive .' yourself."
  exit 1
else
  echo "vcstool ('vcs') not found; using the existing external/ checkout as-is."
fi
# Log what will be built, but never let a missing/broken vcs abort the build.
if command -v vcs >/dev/null 2>&1; then
  echo "Building from these external sources:"
  vcs export --exact external 2>/dev/null || true
fi

echo "Building $ARCH ROS 2 Benchmark Container for ROS ${ROS_DISTRO}."
# BAKE_EXTRA_ARGS lets CI inject cache flags (e.g. --set *.cache-from=type=gha,...)
# without changing local behaviour; it is empty for normal local builds.
docker buildx bake ${CONTAINER_BUILD_TARGET} --load ${BAKE_EXTRA_ARGS}