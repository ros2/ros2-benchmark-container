# =================================================================================================
# This script builds the Docker container for the ROS 2 Benchmarking Suite.
# It supports multiple ROS 2 distributions and allows specifying the build target.
#
# Usage:
#   ./build_benchmark_container.sh [ROS_DISTRO] [CONTAINER_BUILD_TARGET]
# =================================================================================================

# Supported ROS 2 distributions
usage() {
  echo "Usage: $0 [-d <ros_distro>] [-a <architecture>]"
  exit 1
}
SUPPORTED_DISTROS=("jazzy" "kilted" "lyrical" "rolling")
# The ROS distribution to build the container for (default is "jazzy")
ROS_DISTRO="jazzy"
ARCH="$(dpkg --print-architecture)"

while [[ $# -gt 0 ]]; do
  key="$1"
  case $key in 
  -d | --distro)
    ROS_DISTRO="$2"
    shift 2
    ;;
  -a | --architecture)
    ARCH="$2"
    shift 2
    ;;
  *)
    echo "Unknown option: $key"
    usage
    ;;
  esac

done

if [[ ! "${SUPPORTED_DISTROS[@]}" =~ "${ROS_DISTRO}" ]]; then
    echo "ERROR: Unsupported ROS 2 distribution: '${ROS_DISTRO}'"
    echo "Supported distributions are: ${SUPPORTED_DISTROS[*]}. Default to 'jazzy'."
    exit 1
fi

# Export the ROS_DISTRO variable for docker-bake.hcl
export DISTRO="${ROS_DISTRO}"

# The build target to use from docker-bake.hcl (default is "default")
CONTAINER_BUILD_TARGET="${ARCH}"

THIS_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null && pwd )"
PARENT_DIR=$(dirname "${THIS_DIR}")
cd "$PARENT_DIR"

# Populate external/ from external.repos before the build copies it into the
# image. An existing checkout in external/ros2-performance (e.g. a fork under
# active development) is left untouched.
if [ -d external/ros2-performance ]; then
  echo "external/ros2-performance already present; leaving it as-is."
else
  if ! command -v vcs >/dev/null 2>&1; then
    echo "ERROR: external/ros2-performance is missing and vcstool ('vcs') is not installed."
    echo "Install it (e.g. 'pipx install vcstool') or run 'vcs import --input external.repos .' yourself."
    exit 1
  fi
  if ! vcs import --input external.repos .; then
    echo "ERROR: 'vcs import' failed, so external/ was not populated."
    echo "If this is a pkg_resources error, vcstool needs setuptools<82 (vcstool#292)."
    exit 1
  fi
fi
# Log what will be built, but never let a missing/broken vcs abort the build.
if command -v vcs >/dev/null 2>&1; then
  echo "Building from these external sources:"
  vcs export --exact external 2>/dev/null || true
fi

echo "Building $ARCH ROS 2 Benchmark Container for ROS ${ROS_DISTRO}."
# BAKE_EXTRA_ARGS lets CI inject cache flags (e.g. --set *.cache-from=type=gha,...)
# without changing local behaviour; it is empty for normal local builds.
docker buildx bake ${CONTAINER_BUILD_TARGET} --load ${BAKE_EXTRA_ARGS}