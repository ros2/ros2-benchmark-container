# =================================================================================================
# This script runs the Docker container for the ROS 2 Benchmarking Suite.
# It supports multiple ROS 2 distributions and allows specifying the architecture and ROS_DOMAIN_ID.
#
# Usage:
# From the root of this repo,
#   docker/run -d [ROS_DISTRO] -a [ARCH] -i [ROS_DOMAIN_ID] -x SYSTEM_EXECUTOR -t SYSTEM_EXECUTOR_THREADS
# =================================================================================================

usage() {
  echo "Usage: $0 [-d <ros_distro>] [-a <architecture>] [-i <ros_domain_id>] [-x <system_executor>] [-t <threads>] [-w <overlay_workspace>]"
  echo "  -w <overlay_workspace>: host path to a colcon workspace to mount and source"
  echo "                          on top of the image (e.g. a source-built rclcpp)."
  echo "                          Build it inside this container so its ABI matches."
  exit 1
}

ROS_DISTRO="jazzy"
ARCH="$(dpkg --print-architecture)"
ROS_DOMAIN_ID="28"
SYSTEM_EXECUTOR="EventsCBGExecutor"
SYSTEM_EXECUTOR_THREADS="0"
OVERLAY_WS=""

while [[ $# -gt 0 ]]; do
  key="$1"
  case $key in 
  -d | --distro)
    ROS_DISTRO="$2"
    shift 2
    ;;
  -a | --architecture)
    ARCH="$2"
    shift 2
    ;;
  -i | --ros_domain_id)
    ROS_DOMAIN_ID="$2"
    shift 2
    ;;
  -x | --executor)
    SYSTEM_EXECUTOR="$2"
    shift 2
    ;;
  -t | --threads)
    SYSTEM_EXECUTOR_THREADS="$2"
    shift 2
    ;;
  -w | --workspace)
    OVERLAY_WS="$2"
    shift 2
    ;;
  *)
    echo "Unknown option: $key"
    usage
    ;;
  esac

done

APP_NAME="ros2-benchmark-container"
IMAGE_NAME="${APP_NAME}:${ROS_DISTRO}-${ARCH}"
THIS_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null && pwd )"
BENCHMARK_RESULTS_DIR="$(dirname "$THIS_DIR")/benchmark_results/${ROS_DISTRO}"
BENCHMARK_DIR="$(dirname "$THIS_DIR")/benchmark"

if [ ! -d "${BENCHMARK_RESULTS_DIR}" ]; then
  mkdir -p "${BENCHMARK_RESULTS_DIR}";
fi

if [[ "${SYSTEM_EXECUTOR_THREADS}" == "0" ]] &&
   [[ "${SYSTEM_EXECUTOR}" == "MultiThreadedExecutor" || "${SYSTEM_EXECUTOR}" == "EventsCBGExecutor" ]]; then
  echo "[WARN] ${SYSTEM_EXECUTOR} will use std::thread::hardware_concurrency() threads. Pass -t <n> to specify a thread count."
fi

echo "Benchmark results will be available on your machine at" ${BENCHMARK_RESULTS_DIR}

# Optionally overlay a host colcon workspace at /overlay_ws. The container's
# ~/.bashrc sources /overlay_ws/install/setup.bash after the base install, so
# its packages (e.g. a source-built rclcpp) shadow the image's.
OVERLAY_MOUNT=()
if [[ -n "${OVERLAY_WS}" ]]; then
  OVERLAY_WS_ABS="$(cd "${OVERLAY_WS}" >/dev/null 2>&1 && pwd)"
  if [[ -z "${OVERLAY_WS_ABS}" ]]; then
    echo "[ERROR] overlay workspace '${OVERLAY_WS}' not found."
    exit 1
  fi
  if [[ ! -f "${OVERLAY_WS_ABS}/install/setup.bash" ]]; then
    echo "[WARN] ${OVERLAY_WS_ABS}/install/setup.bash not found; it will only be sourced once you 'colcon build' the workspace (inside this container, for ABI match)."
  fi
  OVERLAY_MOUNT=(-v "${OVERLAY_WS_ABS}:/overlay_ws")
  echo "Overlaying workspace ${OVERLAY_WS_ABS} at /overlay_ws."
fi

docker run -it --rm --network=host --privileged --shm-size=1000mb \
-v "${BENCHMARK_RESULTS_DIR}:/benchmark_results" \
-v "${BENCHMARK_DIR}:/ws/src/ros2_benchmark_container/benchmark" \
-v /var/run/docker.sock:/var/run/docker.sock \
"${OVERLAY_MOUNT[@]}" \
-e ROS_DOMAIN_ID=${ROS_DOMAIN_ID} \
-e IMAGE_NAME=${IMAGE_NAME} \
-e SYSTEM_EXECUTOR=${SYSTEM_EXECUTOR} \
-e SYSTEM_EXECUTOR_THREADS=${SYSTEM_EXECUTOR_THREADS} \
--name="${APP_NAME}-${ROS_DISTRO}-${ARCH}" \
${IMAGE_NAME}